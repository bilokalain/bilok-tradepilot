# TradePilot — .gitignore

# --- Données utilisateurs ---
data/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# --- Node ---
node_modules/
frontend/dist/
frontend/.vite/

# --- Environment ---
.env
.env.local
.env.*.local

# --- IDE ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*

# --- Docker ---
docker-compose.override.yml

# --- Celery ---
celerybeat-schedule
celerybeat.pid

# --- DB ---
*.db
*.sqlite3

# --- ML Models (trop lourds pour git) ---
backend/models/*.pt
backend/models/*.bin
backend/models/*.safetensors

# --- Coverage ---
.coverage
htmlcov/
.pytest_cache/

# --- Logs ---
logs/
frontend/logs/

# --- IB Gateway ---
IB Gateway 10.37/

# --- Vercel ---
frontend/.vercel/

# --- Claude ---
.claude/scheduled_tasks.lock

# --- Misc ---
*.pem
*.tsbuildinfo
